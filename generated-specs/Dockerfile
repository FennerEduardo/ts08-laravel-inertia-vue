# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (PHP · Laravel 13).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 8000; probes: liveness /up, readiness /up.

FROM composer:2 AS vendor
WORKDIR /app
COPY . .
RUN composer install --no-dev --prefer-dist --no-progress --no-interaction --optimize-autoloader --no-scripts --ignore-platform-reqs

# FrankenPHP: production PHP application server (Caddy) in one process.
FROM dunglas/frankenphp:1-php8.3-alpine
RUN install-php-extensions pdo_pgsql sockets
WORKDIR /app
COPY --from=vendor /app /app
# APP_KEY must be provided by the platform (secret manager).
ENV SERVER_NAME=:8000 APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr
RUN adduser -D -u 10001 app && mkdir -p /app/storage /app/bootstrap/cache \
    && chown -R app:app /app/storage /app/bootstrap/cache /data/caddy /config/caddy
USER app
EXPOSE 8000
