{
  "name": "app/laravel-inertia-vue-auth",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "ext-pdo_pgsql": "*",
    "ext-sockets": "*",
    "php-amqplib/php-amqplib": "^3.7",
    "open-telemetry/api": "^1.1",
    "open-telemetry/sdk": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "behat/behat": "^3.34"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
